{
  "name": "E-BookStore Chatbot (OpenAI Compatible)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "bookstore-chat"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"deepseek-chat\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"你是在线书店E-BookStore的智能助手。你可以帮助用户搜索书籍、查询书籍信息、按分类浏览、按价格筛选书籍。当用户询问关于书籍的问题时，分析用户意图并返回JSON格式的工具调用指令。可用工具：\\n1. search_books: 搜索书籍，参数: query(关键词), searchType(all/title/author/isbn/category), limit(数量)\\n2. get_book_by_id: 根据ID获取书籍，参数: bookId\\n3. get_books_by_category: 按分类获取，参数: category, limit\\n4. get_all_categories: 获取所有分类，无参数\\n5. get_books_by_price_range: 按价格筛选，参数: minPrice, maxPrice, limit\\n\\n如果需要调用工具，返回格式: {\\\"action\\\": \\\"call_tool\\\", \\\"tool\\\": \\\"工具名\\\", \\\"params\\\": {参数}}\\n如果是普通对话，直接回复文字即可。\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.body.message }}\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 1000\n}",
        "options": {}
      },
      "id": "deepseek-ai",
      "name": "DeepSeek AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 300],
      "credentials": {
        "openAiApi": {
          "id": "your-openai-credential-id",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 解析DeepSeek的响应\nconst response = $input.first().json;\nlet aiResponse = '';\nlet needToolCall = false;\nlet toolInfo = null;\n\ntry {\n  if (response.choices && response.choices[0] && response.choices[0].message) {\n    aiResponse = response.choices[0].message.content;\n    \n    // 尝试解析是否有工具调用\n    try {\n      // 查找JSON格式的工具调用\n      const jsonMatch = aiResponse.match(/\\{[\\s\\S]*\"action\"[\\s\\S]*\"call_tool\"[\\s\\S]*\\}/);\n      if (jsonMatch) {\n        const toolCall = JSON.parse(jsonMatch[0]);\n        if (toolCall.action === 'call_tool') {\n          needToolCall = true;\n          toolInfo = {\n            tool_name: toolCall.tool,\n            parameters: toolCall.params || {}\n          };\n        }\n      }\n    } catch (e) {\n      // 不是工具调用，继续处理为普通响应\n    }\n  }\n} catch (e) {\n  aiResponse = '抱歉，处理您的请求时出现了问题。';\n}\n\nreturn {\n  json: {\n    needToolCall,\n    toolInfo,\n    aiResponse,\n    originalMessage: $('Webhook').first().json.body.message\n  }\n};"
      },
      "id": "parse-response",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [540, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-tool",
              "leftValue": "={{ $json.needToolCall }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-tool-call",
      "name": "Need Tool Call?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/api/call_tool",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.toolInfo) }}",
        "options": {}
      },
      "id": "call-mcp-tool",
      "name": "Call MCP Tool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"deepseek-chat\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"你是在线书店的智能助手。根据查询结果，用友好的中文回复用户。如果是书籍列表，简洁地列出书名、作者和价格。如果没有找到结果，友好地告知用户。\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"用户问题：\" + $('Parse Response').first().json.originalMessage + \"\\n\\n查询结果：\" + JSON.stringify($json)\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 1000\n}",
        "options": {}
      },
      "id": "format-tool-result",
      "name": "Format Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 200],
      "credentials": {
        "openAiApi": {
          "id": "your-openai-credential-id",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nlet reply = '';\n\ntry {\n  if (response.choices && response.choices[0] && response.choices[0].message) {\n    reply = response.choices[0].message.content;\n  } else {\n    reply = '抱歉，处理结果时出现了问题。';\n  }\n} catch (e) {\n  reply = '抱歉，生成回复时出现了问题。';\n}\n\nreturn {\n  json: {\n    reply,\n    success: true\n  }\n};"
      },
      "id": "prepare-tool-response",
      "name": "Prepare Tool Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 200]
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    reply: $('Parse Response').first().json.aiResponse,\n    success: true\n  }\n};"
      },
      "id": "prepare-direct-response",
      "name": "Prepare Direct Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "POST, OPTIONS"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type"
              }
            ]
          }
        }
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1640, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "DeepSeek AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DeepSeek AI": {
      "main": [
        [
          {
            "node": "Parse Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Response": {
      "main": [
        [
          {
            "node": "Need Tool Call?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Need Tool Call?": {
      "main": [
        [
          {
            "node": "Call MCP Tool",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Prepare Direct Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call MCP Tool": {
      "main": [
        [
          {
            "node": "Format Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Result": {
      "main": [
        [
          {
            "node": "Prepare Tool Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Tool Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Direct Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}


